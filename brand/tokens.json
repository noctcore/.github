{
  "$description": "noctcore blueprint tokens. Hex sRGB is the source of truth, taken from the noctcore/auth brand source (assets/brand/design.mjs). OKLCH values are calculated from the hex.",
  "color": {
    "background": { "role": "Field: night or paper", "dark": "#17212D", "light": "#F6F5F1", "oklch": { "dark": "oklch(0.244064 0.027165 253.382)", "light": "oklch(0.969807 0.005408 95.100)" } },
    "foreground": { "role": "Ink: wordmark, headline, step names", "dark": "#F0F3F6", "light": "#202B39", "oklch": { "dark": "oklch(0.962726 0.005147 247.877)", "light": "oklch(0.285357 0.030053 254.712)" } },
    "accent": { "role": "Steel blue: mark, route, block faces", "dark": "#AAC8E2", "light": "#355E87", "oklch": { "dark": "oklch(0.819224 0.048956 244.585)", "light": "oklch(0.470960 0.081369 249.927)" } },
    "secondary": { "role": "Muted ink: subline, secondary labels", "dark": "#B3BEC9", "light": "#596773", "oklch": { "dark": "oklch(0.796355 0.019786 248.077)", "light": "oklch(0.506390 0.025655 244.160)" } },
    "stop": { "role": "Salmon copper: stopped branches and their labels only", "dark": "#D9A08E", "light": "#92513E", "oklch": { "dark": "oklch(0.755069 0.073037 38.251)", "light": "oklch(0.507415 0.092265 37.120)" } },
    "line": { "role": "Construction line, leader to a step name", "dark": "#405367", "light": "#B9C6D0" },
    "grid": { "role": "Grid line, drawn at 48% opacity", "dark": "#253344", "light": "#E3E6E6" },
    "raised": { "role": "Raised route bed", "dark": "#202F40", "light": "#EDF0F1" },
    "side": { "role": "Side faces of a block", "dark": "#2C4055", "light": "#CCD8E1" },
    "shadow": { "role": "Depth plane under the bed", "dark": "#101924", "light": "#DDE2E4" }
  },
  "grid": { "cell": 40, "opacity": 0.48 },
  "type": {
    "display": { "family": "Manrope", "weight": 600, "file": "fonts/Manrope.ttf", "license": "OFL-1.1" },
    "sans": { "family": "Manrope", "weight": 550, "file": "fonts/Manrope.ttf", "license": "OFL-1.1" },
    "mono": { "family": "DM Mono", "weight": 400, "file": "fonts/DMMono-Regular.ttf", "license": "OFL-1.1" }
  },
  "size": {
    "header": { "width": 1280, "height": 360 },
    "social": { "width": 1280, "height": 640, "safe": [100, 76, 1176, 560] },
    "profile": { "width": 1280, "height": 360, "export": 2 }
  },
  "diagram": {
    "space": [1040, 640],
    "headerTransform": "translate(690 10) scale(.49)",
    "rise": "874 across, 340 up (21.3 degrees)",
    "blockDepth": 7,
    "maxSteps": 4,
    "maxStops": 3
  }
}
